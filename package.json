{
  "name": "research-desk",
  "version": "0.2.0",
  "private": true,
  "description": "研序 — 有据可循的科研工作台",
  "author": "Research Desk",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "start": "electron .",
    "test": "npm run build && node --test test/core.test.mjs",
    "desktop-smoke": "npm run build && electron test/desktop-smoke.cjs",
    "packaged-smoke": "node test/packaged-smoke.mjs",
    "dist": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "org.researchdesk.desktop",
    "productName": "Research Desk",
    "directories": {
      "output": "release"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "electron/**/*",
      "service/**/*",
      "agent/**/*",
      "shared/**/*",
      "renderer/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "artifactName": "Research-Desk-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.3.0"
  }
}
